# Локальные учебные настройки, соответствующие docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=synthesis_user
DATABASE_PASSWORD=synthesis_password
DATABASE_NAME=synthesis_db

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=synthesis-media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

LABORATORY_SYNTHESIS_IMAGE_MAX_BYTES=10485760
LABORATORY_SYNTHESIS_VIDEO_MAX_BYTES=67108864

REDIS_URL=redis://localhost:6380/0
SESSION_TTL_SECONDS=900
# Для HTTPS выставить true.
SESSION_COOKIE_SECURE=false

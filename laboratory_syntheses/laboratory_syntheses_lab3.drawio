  <diagram name="ЛР3 — диаграмма классов" id="lab3">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="synth_interface" value="&lt;&lt;interface&gt;&gt;&lt;br&gt;HTTP: /api/laboratory_syntheses&lt;hr&gt;+ GET / (max_duration: int?)&lt;br&gt;+ GET /feed, /feed/{id} (next: bool?)&lt;br&gt;+ GET /draft&lt;br&gt;+ POST / (name, image: File, video: File)&lt;br&gt;+ PUT /draft/publication (description, duration, temperature)&lt;br&gt;+ DELETE /{id}&lt;br&gt;+ POST /{id}/likes (liked: 0|1)" style="swimlane;html=1;startSize=30;rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="390" height="280" as="geometry"/></mxCell>
        <mxCell id="user_interface" value="&lt;&lt;interface&gt;&gt;&lt;br&gt;HTTP: /api/laboratory_synthesis_users&lt;hr&gt;+ POST / (name, password)&lt;br&gt;+ POST /login → 501 (ЛР4)&lt;br&gt;+ POST /logout → 501 (ЛР4)" style="swimlane;html=1;startSize=30;rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="390" height="170" as="geometry"/></mxCell>
